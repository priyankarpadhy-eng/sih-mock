<?xml version="1.0"?>
<!-- ============================================================================== -->
<!-- Palo Alto Networks Next-Gen Firewall Configuration (PAN-OS 10.1.0)             -->
<!-- Target: PA-3220 Perimeter Security Gateway                                     -->
<!-- Non-Compliance Findings: HTTP management enabled, idle-timeout unconfigured    -->
<!-- ============================================================================== -->
<config version="10.1.0" urldb="paloaltonetworks">
  <mgt-config>
    <users>
      <entry name="admin">
        <phash>$1$qwe$rtyuiopasdfghjkl</phash>
        <permissions>
          <role-based>
            <superuser>yes</superuser>
          </role-based>
        </permissions>
      </entry>
    </users>
  </mgt-config>
  <shared>
    <application/>
    <service/>
    <botnet/>
  </shared>
  <devices>
    <entry name="localhost.localdomain">
      <deviceconfig>
        <system>
          <type>
            <static/>
          </type>
          <update-server>updates.paloaltonetworks.com</update-server>
          <update-schedule>
            <threats>
              <recurring>
                <every-30-mins>
                  <action>download-and-install</action>
                </every-30-mins>
              </recurring>
            </threats>
          </update-schedule>
          <timezone>US/Pacific</timezone>
          <service>
            <disable-telnet>no</disable-telnet>
            <disable-http>no</disable-http>
          </service>
          <hostname>FW-PAN-TACTICAL-01</hostname>
          <ip-address>10.0.10.1</ip-address>
          <netmask>255.255.255.0</netmask>
          <default-gateway>10.0.10.254</default-gateway>
        </system>
      </deviceconfig>
    </entry>
  </devices>
</config>
