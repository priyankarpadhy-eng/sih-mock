# =========================================================
# SENTINEL-NET ENVIRONMENT CONFIGURATION TEMPLATE
# SIH Problem Statement 26155 (NTRO / NCIIPC)
# =========================================================

# 1. Firebase Admin SDK & Cloud Firestore Credentials (Optional - Falls back to local JSON)
FIREBASE_PROJECT_ID=sih-2026-sentinel
FIREBASE_CLIENT_EMAIL=your-service-account@sih-2026-sentinel.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----"
FIREBASE_DATABASE_URL=https://sih-2026-sentinel-default-rtdb.firebaseio.com

# 2. OpenRouter AI Multi-Key Failover Pool (Optional - Falls back to offline deterministic parsing)
# Comma-separated API keys for automated key rotation and rate-limit mitigation:
OPENROUTER_API_KEYS=sk-or-v1-key1,sk-or-v1-key2,sk-or-v1-key3
OPENROUTER_DEFAULT_MODEL=google/gemini-2.0-flash-lite-preview-02-05:free

# 3. Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production

# 4. Database & Cache URLs (For Docker Compose or External PostgreSQL)
DATABASE_URL=postgresql://sentinel:sentinelpass@localhost:5432/sentinel_db
REDIS_URL=redis://localhost:6379/0

# 5. Frontend API Target
NEXT_PUBLIC_API_URL=http://localhost:8000
